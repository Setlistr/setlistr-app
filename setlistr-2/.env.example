# Example environment file. No .env.example existed in this repo before
# this entry — scoped here to the ACR credential variables introduced by
# this change; it is not a full inventory of every variable the app uses
# (see CLAUDE.md's own Environment Variables table for that).
#
# Server-only — never NEXT_PUBLIC_-prefixed. Required by app/api/identify,
# app/api/upload-identify, and app/api/upload-recognize; a missing value
# returns a controlled error before any quota consumption or provider call.
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
